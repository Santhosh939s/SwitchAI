# SwitchAI Environment Configuration Template

# App
PROJECT_NAME="SwitchAI"
SECRET_KEY="generate_a_secure_random_string_here"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="sqlite:///./switchai.db"

# Security / Encryption (32-byte url-safe base64 key)
ENCRYPTION_KEY="generate_a_32_byte_base64_encryption_key_here"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Local AI Provider (OpenAI-compatible llama.cpp / local server)
LOCAL_AI_BASE_URL="http://127.0.0.1:8080/v1"
LOCAL_AI_MODEL="Qwen2.5-1.5B-Instruct-Q4_K_M"
